{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "default"
            ],
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Enable SDI print",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "default",
                "--target",
                "enable-sdi"
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Flash",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "default",
                "--target",
                "flash"
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Erase flash",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "default",
                "--target",
                "erase"
            ],
            "problemMatcher": []
        }
    ]
}
