    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Enable SDI print",
            "command": "${userHome}/wlink-linux-x64/wlink sdi-print enable",
            "problemMatcher": []
        }
    ]
}
